# Copy this file to ".env" and edit. NEVER commit .env or put access keys in it.
# Credentials come from `aws configure`.

AWS_REGION=us-east-1

# 1) Save data in Amazon DynamoDB (table is created automatically)
USE_DYNAMODB=false

# 2) Use Amazon Bedrock for the allocation suggestion (falls back to rules if it fails)
USE_BEDROCK=false
BEDROCK_MODEL_ID=amazon.nova-lite-v1:0

# 3) Notify volunteers through Amazon SNS (leave empty to skip)
SNS_TOPIC_ARN=
